# install.packages("lme4")
library(lme4)
getwd()
data_path <- "/Users/zwang13/Documents/Projects/2025_AIculture/WVS/code_v2/R/"
# read data
df <- read.csv(data_path + "df_data_byitem_gpt.csv")
# read data
df <- read.csv(data_path, "df_data_byitem_gpt.csv")
data_path <- "/Users/zwang13/Documents/Projects/2025_AIculture/WVS/code_v2/R/"
# read data
file_path <- file.path(data_path, "df_data_byitem_gpt.csv")
df <- read.csv(file_path)
model <- glmer(
correct ~ abs_weight_z * cultural_dist2US_z +
(1 | item) + (1 | country),
data = df,
family = binomial(link = "logit")
)
summary(model)
capture.output(summary(model),
file = "/Users/zwang13/Documents/Projects/2025_AIculture/WVS/code_v2/R/gpt_mixed_model_summary.txt"
)
